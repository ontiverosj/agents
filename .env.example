# Copy to .env and fill in to enable live search-demand data in Insights
# and SEO keyword targets in brand packages.
#
# Get a key at https://www.semrush.com/api-documentation/ (requires a
# Semrush plan with API units). Responses are cached in-memory for 24h
# to conserve units.
SEMRUSH_API_KEY=

# Optional overrides
# SEMRUSH_DATABASE=us
# PORT=3000
