# All variables are optional — the app runs fully on sample data with none set.

# Server
PORT=3000
# Directory for the SQLite database file. On Railway, mount a volume (e.g. /data)
# and set DATA_DIR to its mount path so data survives deploys.
DATA_DIR=./data

# Live TikTok data via Apify (https://apify.com — TikTok Scraper actor).
# When unset, the app uses a realistic built-in sample-data provider.
APIFY_TOKEN=

# AI game plans via the Claude API. When unset, a built-in template
# generator produces game plans instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# How often tracked niches are re-fetched to build metric history (minutes).
REFRESH_INTERVAL_MINUTES=360

# Optional: protect the dashboard + API with HTTP basic auth (user: any, password: this).
# The legacy /agent/* endpoints are exempt.
DASHBOARD_PASSWORD=

# Legacy lead-scout API (POST /agent/scout). Endpoint returns 503 when unset.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
