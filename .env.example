# Environment variables for the Everflow Acquisitions dashboard + agent chat.
# Copy this file to ".env" and fill in the values. ".env" is gitignored.

# REQUIRED for the AI chat (/dashboard/chat) to reply.
# Create one at https://console.anthropic.com  ->  Settings -> API Keys.
# The account needs billing set up; chat costs a few cents per message.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL. Override the chat model. Defaults to claude-opus-4-8.
# Cheaper options: claude-sonnet-4-6  or  claude-haiku-4-5
# CHAT_MODEL=claude-opus-4-8

# OPTIONAL. Only needed for the Airtable "Leads" view (/dashboard/leads).
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# OPTIONAL. Point the pipeline dashboard at a live sourcing run.
# Defaults to the bundled data/prospects.sample.json.
# PROSPECTS_FILE=./data/prospects.json

# OPTIONAL. Port the server listens on. Defaults to 3000.
# PORT=3000
