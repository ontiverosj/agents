# Emissary environment
# Live Architect mode: set your Anthropic API key and restart the dev server.
# Without it the Architect runs in sample mode (playbook library).
ANTHROPIC_API_KEY=

# Google sign-in (Auth.js). Create OAuth credentials at console.cloud.google.com
# (APIs & Services -> Credentials -> OAuth client ID -> Web application) and add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
AUTH_SECRET=            # generate with: openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
